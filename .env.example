# Optional. When set, page classification and plan/fact/material extraction use Claude vision.
# When unset, the local extractor runs (text layer + OCR + image heuristics) and plans are traced by hand.
ANTHROPIC_API_KEY=
# Optional model override (default claude-opus-5)
ANTHROPIC_MODEL=
# Where job folders live (default ./data/jobs)
DATA_DIR=

# Optional: any OpenAI-compatible gateway instead of Claude. All four must be set.
# Check it with: npm run llm-check
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
